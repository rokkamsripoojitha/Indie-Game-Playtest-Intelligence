# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/playtest_intelligence?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/playtest_intelligence
MONGODB_VECTOR_INDEX_NAME=playtest_vector_index

# Session & Security
SESSION_SECRET=super_secret_session_encryption_key_change_in_production
SESSION_MAX_AGE_MS=86400000

# AI Configuration (Ollama / Local / Compatible Endpoint)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSION=384

# Email Service Configuration (Development or Production SMTP)
EMAIL_SERVICE_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@playtest-intelligence.local

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760
